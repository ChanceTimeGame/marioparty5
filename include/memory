/*  <memory> -- minimal reconstruction of the parts of Metrowerks MSL C++ (CodeWarrior GC 1.3.2 era)
 *  that <vector>, <tree>/<map> and the m539 overlay need: std::allocator, std::auto_ptr and
 *  Metrowerks::compressed_pair.  No exceptions.
 */
#ifndef _MEMORY
#define _MEMORY

#include <mslconfig>
#include <new>
#include <limits>
#include <algorithm>

namespace std {

template <class T>
class allocator
{
public:
	typedef unsigned long size_type;
	typedef long          difference_type;
	typedef T*            pointer;
	typedef const T*      const_pointer;
	typedef T&            reference;
	typedef const T&      const_reference;
	typedef T             value_type;

	// No user-declared destructor: a class holding an allocator must stay
	// trivially copyable (the swap in __vector_pod<T>::insert is a plain word copy).
	allocator() {}

	pointer allocate(size_type n, const void* = 0)
	{
		pointer result = static_cast<pointer>(::operator new(n * sizeof(T)));
		if (result == 0)
			__msl_error("Memory allocation failure");
		return result;
	}
	void deallocate(pointer p, size_type) { ::operator delete(p); }
	size_type max_size() const { return numeric_limits<size_type>::max() / sizeof(T); }
	void construct(pointer p, const T& val) { new(p) T(val); }
	void destroy(pointer p) { p->~T(); }
};

// auto_ptr (C++98 20.4.5).  m539: 4-byte member; reset() = if (p != q) {delete p; p = q;};
// ~auto_ptr() = delete p (no outer test: CW's delete tests the pointer itself).
template <class X> class auto_ptr;

template <class Y>
struct auto_ptr_ref
{
	Y* p_;
	explicit auto_ptr_ref(Y* p) : p_(p) {}
};

template <class X>
class auto_ptr
{
public:
	typedef X element_type;

	explicit auto_ptr(X* p = 0) : ptr_(p) {}
	auto_ptr(auto_ptr& a) : ptr_(a.release()) {}
	template <class Y> auto_ptr(auto_ptr<Y>& a) : ptr_(a.release()) {}
	auto_ptr(auto_ptr_ref<X> r) : ptr_(r.p_) {}
	~auto_ptr() { delete ptr_; }

	auto_ptr& operator=(auto_ptr& a) { reset(a.release()); return *this; }
	template <class Y> auto_ptr& operator=(auto_ptr<Y>& a) { reset(a.release()); return *this; }
	auto_ptr& operator=(auto_ptr_ref<X> r) { reset(r.p_); return *this; }

	X& operator*() const { return *ptr_; }
	X* operator->() const { return ptr_; }
	X* get() const { return ptr_; }
	X* release() { X* tmp = ptr_; ptr_ = 0; return tmp; }
	void reset(X* p = 0)
	{
		if (ptr_ != p)
		{
			delete ptr_;
			ptr_ = p;
		}
	}

	template <class Y> operator auto_ptr_ref<Y>() { return auto_ptr_ref<Y>(release()); }
	template <class Y> operator auto_ptr<Y>() { return auto_ptr<Y>(release()); }

private:
	X* ptr_;
};

} // namespace std

namespace Metrowerks {

// Empty-member optimisation: T2 (an empty allocator) is a base, so the pair is
// sizeof(T1) and second() is the pair itself.
template <class T1, class T2>
class compressed_pair
	: private T2
{
public:
	compressed_pair() {}
	compressed_pair(T1 x) : first_(x) {}
	compressed_pair(T1 x, const T2&) : first_(x) {}
	// <tree>: the begin pointer is set in the __tree constructor body; only the
	// comparison (the empty base) is copied in the initializer (drum 7AD0 `stb`).
	explicit compressed_pair(const T2& y) : T2(y) {}
	T1&       first()        { return first_; }
	const T1& first() const  { return first_; }
	T2&       second()       { return *this; }
	const T2& second() const { return *this; }
	void swap(compressed_pair& y) { std::swap(first_, y.first_); }
private:
	T1 first_;
};

} // namespace Metrowerks

namespace std {

template <class T1, class T2>
inline void swap(Metrowerks::compressed_pair<T1, T2>& x, Metrowerks::compressed_pair<T1, T2>& y)
{
	x.swap(y);
}

} // namespace std

#endif
