        insert(end(), n - size(), x);                                                                 \
    else if (n < size())                                                                              \
        erase(begin() + n, end());                                                                    \
}                                                                                                     \
                                                                                                      \
template <class Allocator>                                                                            \
typename __vector_pod<type, Allocator>::iterator                                                      \
__vector_pod<type, Allocator>::erase(iterator first, iterator last)                                   \
{                                                                                                     \
    if (first == last)                                                                                \
        return first;                                                                                 \
    iterator e = end();                                                                               \
    size_type n_move = static_cast<size_type>(e - last);                                              \
    if (n_move)                                                                                       \
        copy((S*)last, (S*)e, (S*)first);                                                             \
    size_ -= last - first;                                                                            \
    return first;                                                                                     \
}

