/*  <vector> -- reconstruction of the Metrowerks MSL C++ vector used by Mario Party 5's
 *  C++ minigame overlays (CodeWarrior GC 1.3.2, -Cpp_exceptions off).  See ../REPORT.md.
 *
 *  Layering (each level is a distinct class; CodeWarrior emits one `this != 0` check per
 *  inlined destructor level, and the retail code shows exactly three):
 *
 *      vector<T, A>                       interface: push_back, operator[], ...
 *        : __vector_pod<T, A>             insert / at / reserve (out of line); scalar T also
 *                                         resize(n) (inline) / resize(n, x) / erase(first, last)
 *            : __vector_base<T, A, pod>   storage: cap_ (+allocator), size_, data_
 *
 *  Object layout (12 bytes): +0 capacity (compressed with the empty allocator),
 *  +4 size, +8 data pointer.
 *
 *  Element types fall into two families that the retail code implements differently:
 *  scalars (a partial specialization of __vector_pod per builtin type, generated by
 *  _MSL_VECTOR_POD below: raw moves, no per-element construct, no temporary buffer) and
 *  everything else (the primary template: construct/destroy per element, a temporary
 *  __vector_base plus swap on reallocation, out-of-line destructor).  The two cannot be
 *  one body selected by `if (is_POD<T>::value)` or an int2type overload: CodeWarrior still
 *  expands the inline calls of a dead branch, and those temporaries change the register
 *  allocation of the live one (REPORT.md, "quirks").
 */
#ifndef _VECTOR
#define _VECTOR

#include <mslconfig>
#include <memory>
#include <algorithm>

namespace std {

template <class T, class Allocator, bool IsPOD> class __vector_base;

//  __vector_base<T, A, false> -- storage for non-trivial element types

template <class T, class Allocator>
class __vector_base<T, Allocator, false>
{
public:
	typedef T                                   value_type;
	typedef Allocator                           allocator_type;
	typedef typename Allocator::size_type       size_type;
	typedef typename Allocator::difference_type difference_type;
	typedef typename Allocator::reference       reference;
	typedef typename Allocator::const_reference const_reference;
	typedef typename Allocator::pointer         pointer;
	typedef typename Allocator::const_pointer   const_pointer;
	typedef pointer                             iterator;
	typedef const_pointer                       const_iterator;

	__vector_base() : cap_(0), size_(0), data_(0) {}
	explicit __vector_base(const allocator_type& a) : cap_(0, a), size_(0), data_(0) {}
	~__vector_base();

	iterator begin() { return data_.first(); }
	iterator end() { return data_.first() + size_; }
	// m522 fire: the implicit copy/assignment of an element holding a vector (Flare) reads the source's range.
	const_iterator begin() const { return data_.first(); }
	const_iterator end() const { return data_.first() + size_; }
	size_type size() const { return size_; }
	size_type capacity() const { return cap_.first(); }
	size_type max_size() const { return alloc().max_size(); }
	void clear();
	// Retail stores a temporary's capacity through one more inline level than its data
	// pointer (m501 insert<HuVec2f_s>: `addi r0,r1,0xb8; stw r0,0x28(r1); lwz r3,0x28(r1)`).
	size_type& cap() { return cap_.first(); }

	void swap(__vector_base& x)
	{
		if (this != &x)
		{
			std::swap(cap_, x.cap_);
			std::swap(data_, x.data_);
			std::swap(size_, x.size_);
		}
	}

public:	// implementation detail; __vector_pod works on a temporary base object
	class __ptr
	{
	public:
		__ptr(pointer p) : p_(p) {}
		pointer&       first()       { return p_; }
		const pointer& first() const { return p_; }
	private:
		pointer p_;
	};

	allocator_type&       alloc()       { return cap_.second(); }
	const allocator_type& alloc() const { return cap_.second(); }

	Metrowerks::compressed_pair<size_type, allocator_type> cap_;
	size_type size_;
	__ptr     data_;
};

// Out of line on purpose: a template member defined outside the class is instantiated
// after its first user has been compiled, so CodeWarrior's auto-inliner never sees it
// (retail: m501 fn_1_7328 / fn_1_729C are calls, never inlined).
template <class T, class Allocator>
void
__vector_base<T, Allocator, false>::clear()
{
	pointer b = data_.first();
	pointer e = b + size_;
	while (e > b)
		alloc().destroy(--e);
	size_ = 0;
}

template <class T, class Allocator>
__vector_base<T, Allocator, false>::~__vector_base()
{
	clear();
	if (data_.first())
		alloc().deallocate(data_.first(), cap_.first());
}

//  __vector_base<T, A, true> -- storage for scalar element types

template <class T, class Allocator>
class __vector_base<T, Allocator, true>
{
public:
	typedef T                                   value_type;
	typedef Allocator                           allocator_type;
	typedef typename Allocator::size_type       size_type;
	typedef typename Allocator::difference_type difference_type;
	typedef typename Allocator::reference       reference;
	typedef typename Allocator::const_reference const_reference;
	typedef typename Allocator::pointer         pointer;
	typedef typename Allocator::const_pointer   const_pointer;
	typedef pointer                             iterator;
	typedef const_pointer                       const_iterator;

	__vector_base() : cap_(0), size_(0), data_(0) {}
	explicit __vector_base(const allocator_type& a) : cap_(0, a), size_(0), data_(0) {}
	~__vector_base()
	{
		if (data_.first())
			alloc().deallocate(data_.first(), cap());
	}
	// m539 ~CObjSet: retail calls the capacity accessor out of line (fn_1_86A8) before alloc() (86A4).
	size_type& cap() { return cap_.first(); }

	iterator begin() { return data_.first(); }
	iterator end() { return data_.first() + size_; }
	size_type size() const { return size_; }
	size_type capacity() const { return cap_.first(); }
	size_type max_size() const { return alloc().max_size(); }
	void clear() { size_ = 0; }

	void swap(__vector_base& x)
	{
		if (this != &x)
		{
			std::swap(cap_, x.cap_);
			std::swap(data_, x.data_);
			std::swap(size_, x.size_);
		}
	}

public:	// implementation detail; __vector_pod works on a temporary base object
	class __ptr
	{
	public:
		__ptr(pointer p) : p_(p) {}
		pointer&       first()       { return p_; }
		const pointer& first() const { return p_; }
	private:
		pointer p_;
	};

	allocator_type&       alloc()       { return cap_.second(); }
	const allocator_type& alloc() const { return cap_.second(); }

	Metrowerks::compressed_pair<size_type, allocator_type> cap_;
	size_type size_;
	__ptr     data_;
};

//  __vector_pod<T, A> -- primary template: non-trivial element types

template <class T, class Allocator>
class __vector_pod
	: public __vector_base<T, Allocator, false>
{
	typedef __vector_base<T, Allocator, false> base;
public:
	typedef typename base::value_type      value_type;
	typedef typename base::allocator_type  allocator_type;
	typedef typename base::size_type       size_type;
	typedef typename base::difference_type difference_type;
	typedef typename base::reference       reference;
	typedef typename base::const_reference const_reference;
	typedef typename base::pointer         pointer;
	typedef typename base::iterator        iterator;
	typedef typename base::const_iterator  const_iterator;

	__vector_pod() {}
	explicit __vector_pod(const allocator_type& a) : base(a) {}
	__vector_pod(const __vector_pod& x) : base(x.alloc())
		{__init(x.begin(), x.end(), typename iterator_traits<typename base::const_iterator>::iterator_category());}

	void insert(iterator position, size_type n, const value_type& x);
	reference at(size_type n);
	void reserve(size_type n);
	iterator erase(iterator position);
	// m522 fire (vector<Wave>(n), vector<Vec>::assign(n, x), Flare's implicit copy/assignment):
	void __init(size_type n, const value_type& x);
	void assign(size_type n, const value_type& x);
	template <class ForwardIterator>
	void __init(ForwardIterator first, ForwardIterator last, forward_iterator_tag);
	template <class ForwardIterator>
	void assign(ForwardIterator first, ForwardIterator last)
		{__assign(first, last, typename iterator_traits<ForwardIterator>::iterator_category());}
	template <class ForwardIterator>
	void __assign(ForwardIterator first, ForwardIterator last, forward_iterator_tag);
};

template <class T, class Allocator>
void
__vector_pod<T, Allocator>::insert(iterator position, size_type n, const value_type& x)
{
	if (n > 0)
	{
		size_type ms = max_size();
		if (n > ms || size_ > ms - n)
			__msl_error("vector::insert length error\n");
		if (size_ + n <= capacity())
		{
			iterator old_end = end();
			size_type n_move = static_cast<size_type>(old_end - position);
			const value_type* xp = &x;
			if (n > n_move)
			{
				iterator i = old_end;
				for (; n > n_move; ++i, --n, ++size_)
					alloc().construct(i, x);
				for (iterator j = position; j < old_end; ++j, ++i, ++size_)
					alloc().construct(i, *j);
			}
			else
			{
				iterator j = old_end - n;
				iterator i = old_end;
				for (; j < old_end; ++j, ++i, ++size_)
					alloc().construct(i, *j);
				if (old_end - (n_move - n) <= xp && xp < old_end)
					xp += n;
				copy_backward(position, position + (n_move - n), old_end);
			}
			__fill_n(position, n, *xp);
		}
		else
		{
			base tmp(alloc());
			size_type new_size = size_ + n;
			size_type new_cap = cap_.first() ? cap_.first() : 1;
			while (new_size > new_cap)
			{
				if (new_cap < ms / 2)
					new_cap *= 2;
				else
					new_cap = ms;
			}
			tmp.data_.first() = tmp.alloc().allocate(new_cap);
			tmp.cap() = new_cap;
			iterator i = tmp.data_.first();
			iterator j = begin();
			iterator e = end();
			for (; j < position; ++j, ++i, ++tmp.size_)
				tmp.alloc().construct(i, *j);
			for (; n > 0; ++i, --n, ++tmp.size_)
				tmp.alloc().construct(i, x);
			for (; j < e; ++j, ++i, ++tmp.size_)
				tmp.alloc().construct(i, *j);
			tmp.swap(*this);
		}
	}
}

template <class T, class Allocator>
typename __vector_pod<T, Allocator>::reference
__vector_pod<T, Allocator>::at(size_type n)
{
	if (n >= size_)
		__msl_error("vector::at index out of range");
	return data_.first()[n];
}

// m532 player.o 12C38 (vector<Vec>, the waypoint queue's erase-front): shift down, then destroy the
// old last element (a no-op whose address CW still computes).
template <class T, class Allocator>
typename __vector_pod<T, Allocator>::iterator
__vector_pod<T, Allocator>::erase(iterator position)
{
	iterator e = end();
	size_type n = static_cast<size_type>(e - position - 1);
	if (n != 0)
		copy(position + 1, e, position);
	alloc().destroy(data_.first() + --size_);
	return position;
}

// m522 fire 26A8 (vector<Wave>(0x400), the base already zeroed by the inline constructor).
template <class T, class Allocator>
void
__vector_pod<T, Allocator>::__init(size_type n, const value_type& x)
{
	if (n > 0)
	{
		if (n > max_size())
			__msl_error("vector length error\n");
		data_.first() = alloc().allocate(n);
		cap() = n;
		pointer e = data_.first() + n;
		for (iterator i = begin(); i < e; ++i, ++size_)
			alloc().construct(i, x);
	}
}

// m522 fire 2F88 (vector<Vec>, Flare's trail.assign(8, pos)).
template <class T, class Allocator>
void
__vector_pod<T, Allocator>::assign(size_type n, const value_type& x)
{
	if (n <= capacity())
	{
		size_type m = min(n, size_);
		iterator i = begin();
		iterator e = i + m;
		for (; i < e; ++i)
			*i = x;
		if (n < size_)
		{
			for (e = end(); i < e; ++i)
				alloc().destroy(i);
			size_ = n;
		}
		else if (size_ < n)
		{
			n -= size_;
			for (; n > 0; --n, ++i, ++size_)
				alloc().construct(i, x);
		}
	}
	else
	{
		if (n > max_size())
			__msl_error("vector::assign length error\n");
		clear();
		if (data_.first())
		{
			alloc().deallocate(data_.first(), cap_.first());
			data_.first() = 0;
			cap() = 0;
		}
		data_.first() = alloc().allocate(n);
		cap() = n;
		for (iterator i = begin(); n > 0; --n, ++i, ++size_)
			alloc().construct(i, x);
	}
}

// m522 fire 4390 (vector<Vec> copy constructor body).  Retail tests size() -- still 0 -- against
// max_size(), not n.
template <class T, class Allocator>
template <class ForwardIterator>
void
__vector_pod<T, Allocator>::__init(ForwardIterator first, ForwardIterator last, forward_iterator_tag)
{
	size_type n = static_cast<size_type>(distance(first, last));
	if (size_ > max_size())
		__msl_error("vector length error\n");
	if (n > 0)
	{
		data_.first() = alloc().allocate(n);
		cap() = n;
		for (iterator i = begin(); first != last; ++i, ++size_, ++first)
			alloc().construct(i, *first);
	}
}

// m522 fire 4504 (vector<Vec>::operator= body).
template <class T, class Allocator>
template <class ForwardIterator>
void
__vector_pod<T, Allocator>::__assign(ForwardIterator first, ForwardIterator last, forward_iterator_tag)
{
	size_type n = static_cast<size_type>(distance(first, last));
	if (n <= capacity())
	{
		size_type m = min(n, size_);
		iterator i = begin();
		iterator e = i + m;
		for (; i < e; ++i, ++first)
			*i = *first;
		if (n < size_)
		{
			for (e = end(); i < e; ++i)
				alloc().destroy(i);
			size_ = n;
		}
		else if (size_ < n)
		{
			for (; first != last; ++first, ++i, ++size_)
				alloc().construct(i, *first);
		}
	}
	else
	{
		if (n > max_size())
			__msl_error("vector::assign length error\n");
		clear();
		if (data_.first())
		{
			alloc().deallocate(data_.first(), cap_.first());
			data_.first() = 0;
			cap() = 0;
		}
		data_.first() = alloc().allocate(n);
		cap() = n;
		for (iterator i = begin(); first != last; ++first, ++i, ++size_)
			alloc().construct(i, *first);
	}
}

// Not exercised by m501; written by analogy with insert's reallocation (unverified).
template <class T, class Allocator>
void
__vector_pod<T, Allocator>::reserve(size_type n)
{
	if (n > cap_.first())
	{
		if (n > max_size())
			__msl_error("vector::reserve length error\n");
		base tmp(alloc());
		tmp.data_.first() = tmp.alloc().allocate(n);
		tmp.cap() = n;
		iterator i = tmp.data_.first();
		for (iterator j = begin(), e = end(); j < e; ++j, ++i, ++tmp.size_)
			tmp.alloc().construct(i, *j);
		tmp.swap(*this);
	}
}

//  __vector_pod<scalar, A> -- one partial specialization per builtin type

// __vector_store<T>::store -- the type a scalar vector's out-of-line members move elements as
// (copy, copy_backward, __fill_n and the aliasing test of insert).  float is moved as unsigned long:
// retail's __vector_pod<float>::insert (m531 cleaneff 11220) is byte-identical to the int one (m501)
// and copies with lwz/stw, never lfs/stfs.  Every call-site cast is needed: with float-typed
// overloads of copy/copy_backward/__fill_n instead, the inline temporaries and the register ranking
// change (best tried: 238 insns, masked 12).  `xp` must itself be a `const S*` (a cast at its use
// leaves insert masked-identical but with three registers rotated: old_end/xp/old_data).
// Types without a specialization keep T (identity casts: every instance compiled by regress.sh is
// unchanged).  double is not specialized: no evidence.
template <class T> struct __vector_store { typedef T store; };
template <> struct __vector_store<float> { typedef unsigned long store; };

#define _MSL_VECTOR_POD(type)                                                                         \
template <class Allocator>                                                                            \
class __vector_pod<type, Allocator>                                                                   \
    : public __vector_base<type, Allocator, true>                                                     \
{                                                                                                     \
    typedef __vector_base<type, Allocator, true> base;                                                \
public:                                                                                               \
    typedef typename base::value_type      value_type;                                                \
    typedef typename base::allocator_type  allocator_type;                                            \
    typedef typename base::size_type       size_type;                                                 \
    typedef typename base::difference_type difference_type;                                           \
    typedef typename base::reference       reference;                                                 \
    typedef typename base::const_reference const_reference;                                           \
    typedef typename base::pointer         pointer;                                                   \
    typedef typename base::iterator        iterator;                                                  \
    typedef __vector_store<type>::store   S;                                                          \
                                                                                                      \
    __vector_pod() {}                                                                                 \
                                                                                                      \
    reference at(size_type n);                                                                        \
    const_reference at(size_type n) const;                                                            \
    void reserve(size_type n);                                                                        \
    iterator erase(iterator position);                                                                \
    void insert(iterator position, size_type n, const value_type& x);                                 \
    void resize(size_type n) { resize(n, value_type()); }                                             \
    void resize(size_type n, const value_type& x);                                                    \
    iterator erase(iterator first, iterator last);                                                    \
    void __init(size_type n, const value_type& x);                                                    \
};                                                                                                    \
                                                                                                      \
/* m579 watereff.o 159E0 (vector<char>(n), CWaterEff::m_copyBuf): size and capacity set, then one     \
   __fill_n over the new block (no per-element size_ increment, unlike the primary template). */      \
template <class Allocator>                                                                            \
void                                                                                                  \
__vector_pod<type, Allocator>::__init(size_type n, const value_type& x)                               \
{                                                                                                     \
    if (n > 0)                                                                                        \
    {                                                                                                 \
        if (n > max_size())                                                                           \
            __msl_error("vector length error\n");                                                     \
        data_.first() = alloc().allocate(n);                                                          \
        cap_.first() = size_ = n;                                                                     \
        __fill_n((S*)data_.first(), n, (const S&)x);                                                  \
    }                                                                                                 \
}                                                                                                     \
                                                                                                      \
template <class Allocator>                                                                            \
void                                                                                                  \
__vector_pod<type, Allocator>::insert(iterator position, size_type n, const value_type& x)            \
{                                                                                                     \
    if (n > 0)                                                                                        \
    {                                                                                                 \
        size_type ms = max_size();                                                                    \
        if (n > ms || size_ > ms - n)                                                                 \
            __msl_error("vector::insert length error\n");                                             \
        if (size_ + n <= capacity())                                                                  \
        {                                                                                             \
            iterator old_end = end();                                                                 \
            size_type n_move = static_cast<size_type>(old_end - position);                            \
            const S* xp = (const S*)&x;                                                               \
            if ((const S*)old_end - (n_move - n) <= xp && xp < (const S*)old_end)                     \
                xp += n;                                                                              \
            if (n_move)                                                                               \
                copy_backward((S*)position, (S*)old_end, (S*)(old_end + n));                          \
            __fill_n((S*)position, n, *xp);                                                           \
            size_ += n;                                                                               \
        }                                                                                             \
        else                                                                                          \
        {                                                                                             \
            size_type before = static_cast<size_type>(position - begin());                            \
            pointer old_data = data_.first();                                                         \
            size_type new_size = size_ + n;                                                           \
            size_type new_cap = cap_.first() ? cap_.first() : 1;                                      \
            while (new_size > new_cap)                                                                \
            {                                                                                         \
                if (new_cap < ms / 2)                                                                 \
                    new_cap *= 2;                                                                     \
                else                                                                                  \
                    new_cap = ms;                                                                     \
            }                                                                                         \
            data_.first() = alloc().allocate(new_cap);                                                \
            __fill_n((S*)(data_.first() + before), n, (const S&)x);                                   \
            if (old_data)                                                                             \
            {                                                                                         \
                copy((S*)old_data, (S*)(old_data + before), (S*)data_.first());                       \
                copy((S*)(old_data + before), (S*)(old_data + size_), (S*)(data_.first() + before + n));\
                alloc().deallocate(old_data, cap_.first());                                           \
            }                                                                                         \
            size_ = new_size;                                                                         \
            cap_.first() = new_cap;                                                                   \
        }                                                                                             \
    }                                                                                                 \
}                                                                                                     \
